# 统一行尾为 LF，杜绝跨设备/跨会话的 CRLF 噪音与“假差异”
* text=auto

*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.py   text eol=lf
*.svg  text eol=lf
*.webmanifest text eol=lf
*.csv  text eol=lf
*.txt  text eol=lf
*.cmd  text eol=crlf

*.png  binary
*.db   binary
*.pyc  binary
